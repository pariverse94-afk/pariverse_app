# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
.expo-export-web-test/

# Firebase Hosting deploy cache (hosting/ itself IS tracked — it holds the
# Play-required account-deletion page)
.firebase/

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Env files — NEVER commit these (repo is public)
.env
.env.*
!.env.example

# Google Cloud / Firebase secrets — NEVER commit these
# google-services.json and GoogleService-Info.plist are intentionally tracked
# (they are project identifiers, not private keys — security is in Firebase rules)
google-play-key.json
*-service-account*.json
firebase-adminsdk-*.json

# Terraform state (contains secrets in plaintext). infra/ was removed with the
# API tier, but keep these so a stray local terraform run can never commit state.
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
*.tfvars.local

# Private business strategy — NEVER commit (repo is public)
MONETIZATION_ROADMAP.md
