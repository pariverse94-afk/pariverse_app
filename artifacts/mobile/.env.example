# Copy to .env.local and fill in. Expo auto-loads .env.local for `expo start`.
# .env.local is gitignored; this example file is committed.
#
# The EXPO_PUBLIC_FIREBASE_* and GOOGLE_WEB_CLIENT_ID values are NOT secrets --
# they are project identifiers, already present in eas.json and
# google-services.json, both intentionally tracked in this public repo.
# Security lives in Firestore rules, not in hiding these.
#
# Copy the real values from artifacts/mobile/eas.json (development profile).

EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# THIS ONE IS A REAL CREDENTIAL. Leave blank unless you are actively working on
# the AI screens -- the app degrades gracefully without it (shows an
# "AI not configured" alert). Anything you put here is compiled into any build
# you make and is extractable from the binary. Use a throwaway key, never the
# production one.
EXPO_PUBLIC_GROQ_API_KEY=
