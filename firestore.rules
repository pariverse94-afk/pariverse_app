rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Private per-user data ────────────────────────────────────────────
    // users/{uid}            → profile (name, familyName, email)
    // users/{uid}/data/*     → family, meals, community (liked/saved/hidden)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /data/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Email lookup ("is this person on Pariverse?") ────────────────────
    // Exact-match `get` only — listing is blocked, so registered emails
    // cannot be enumerated. Each user may only write the entry for the
    // email address on their own account.
    match /emailIndex/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Shared Mom's Corner posts ────────────────────────────────────────
    match /communityPosts/{postId} {
      allow read: if signedIn();

      // Anyone signed in can post as themselves; posts start with 0 likes
      // and are capped at 2000 characters.
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.likeCount == 0;

      // Only the author can delete their post.
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // The author can edit their own post. Everyone else may only change
      // likeCount, and only by exactly +1 or -1 (the like button).
      //
      // NOTE: a bare ±1 is still permitted here on purpose. It is what builds
      // already on testers' devices send, and those builds cannot be updated.
      // It is also the remaining hole: nothing in this branch ties the counter
      // to the likes/{uid} document below, so a determined client can repeat
      // +1. Closing it means requiring the paired write, which would break
      // every installed build the moment it deployed — so it waits until a
      // client that writes both is actually in users' hands.
      // `hidden`, `hiddenAt` and `reportCount` are moderation state. They are
      // written only by the onReportCreated function, which uses the Admin SDK
      // and bypasses these rules entirely. No client may touch them — including
      // the author, who would otherwise be able to un-hide their own post the
      // moment it was moderated.
      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['hidden', 'hiddenAt', 'reportCount'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (request.resource.data.likeCount == resource.data.likeCount + 1
              || request.resource.data.likeCount == resource.data.likeCount - 1)
        )
      );

      // ── Who actually liked what ──────────────────────────────────────────
      // One document per user per post, keyed by uid. Because the id *is* the
      // uid, a second like from the same account overwrites rather than adds —
      // duplicate likes are impossible by construction, not by validation.
      //
      // Purely additive: nothing deployed today reads or writes this path, so
      // granting it cannot affect an installed build.
      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && likeUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }
    }

    // ── UGC reports ──────────────────────────────────────────────────────
    // Clients can only file reports as themselves; reading/handling them
    // happens in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
